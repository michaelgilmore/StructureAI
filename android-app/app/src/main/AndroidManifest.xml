<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ requires this to be requested at runtime even once
         granted here — see push/NotificationHelper.kt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets TextToSpeech bind to the device's TTS engine under Android
         11+ package-visibility rules (see ui/components/VoiceInputButton.kt,
         which speaks a short prompt before opening the voice-add
         recognizer). Without this, PackageManager's engine lookup can come
         back empty even though a TTS engine is installed, and the feature
         silently degrades to "no spoken prompt" instead of actually
         speaking one. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".TodoAiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.TodoFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Exposes the generated report PDF (see util/PdfReportGenerator.kt,
             which writes under context.cacheDir/reports/) to whatever app
             the user picks in the share sheet, without a legacy storage
             permission — see res/xml/file_paths.xml for the matching
             cache-path entry, and ui/report/ReportScreen.kt for the
             ACTION_SEND call site. androidx.core (already a dependency, see
             app/build.gradle.kts) provides this FileProvider class. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
