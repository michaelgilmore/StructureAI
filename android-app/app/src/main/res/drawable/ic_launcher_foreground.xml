<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher glyph: three ascending blocks — each completed todo is one
     more piece put in place, building up to something — with a small
     checkmark cut into the tallest block tying it back to "todo list."
     Drawn in white against @color/launcher_background (the adaptive
     icon's background layer, ic_launcher.xml). Geometry is kept inside
     the ~66dp safe-zone circle centered at (54,54) in this 108dp
     viewport, per Android's adaptive-icon guidance, so it isn't clipped
     by circular/squircle launcher masks. See drawable/ic_launcher_monochrome.xml
     for the Android 13+ themed-icon silhouette (blocks only — a
     same-tone "cutout" checkmark wouldn't render against a single-tone
     themed icon). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Block 1 — shortest -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M31,60 L39,60 A3,3 0 0 1 42,63 L42,71 A3,3 0 0 1 39,74 L31,74 A3,3 0 0 1 28,71 L28,63 A3,3 0 0 1 31,60 Z" />
    <!-- Block 2 — middle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,50 L58,50 A3,3 0 0 1 61,53 L61,71 A3,3 0 0 1 58,74 L50,74 A3,3 0 0 1 47,71 L47,53 A3,3 0 0 1 50,50 Z" />
    <!-- Block 3 — tallest -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M69,40 L77,40 A3,3 0 0 1 80,43 L80,71 A3,3 0 0 1 77,74 L69,74 A3,3 0 0 1 66,71 L66,43 A3,3 0 0 1 69,40 Z" />
    <!-- Checkmark cut into block 3, in the background color -->
    <path
        android:strokeColor="@color/launcher_background"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M70,54 L73,57.5 L78,50" />
</vector>
